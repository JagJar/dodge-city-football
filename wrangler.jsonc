{
	"name": "dodge-city-football-rebuild",
	"main": "./worker.js",
	// Set to the date this config was created.
	"compatibility_date": "2026-09-23",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/cache/*", "!/templates/*"],
		"html_handling": "none",
		"not_found_handling": "404-page"
	}
}
